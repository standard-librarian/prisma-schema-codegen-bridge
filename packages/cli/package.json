    "directory": "packages/cli"
  },
  "type": "module",
  "bin": {
    "schema-codegen-bridge": "./dist/bin.js"
  },
  "files": ["dist", "README.md"],
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "build": "tsc -p .",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@zenstackhq/cli": "^3.9.3"
