{
  "name": "@mdht/plugin-ts-rest-contract",
  "version": "0.2.0",
  "description": "ZenStack v3 CLI plugin: generate a ts-rest CRUD contract (Effect Schema, via Standard Schema) from your ZModel schema.",
  "keywords": ["zenstack", "zmodel", "codegen", "ts-rest", "effect", "standard-schema"],
  "license": "MIT",
  "author": "standard-librarian",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/standard-librarian/prisma-schema-codegen-bridge.git",
    "directory": "packages/plugin-ts-rest-contract"
  },
  "homepage": "https://github.com/standard-librarian/prisma-schema-codegen-bridge#readme",
  "bugs": "https://github.com/standard-librarian/prisma-schema-codegen-bridge/issues",
  "publishConfig": { "access": "public" },
  "type": "module",
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./plugin.zmodel": "./plugin.zmodel"
  },
  "files": ["index.ts", "plugin.zmodel", "README.md"],
  "engines": {
    "node": ">=22.6.0"
  },
  "peerDependencies": {
    "@ts-rest/core": "3.53.0-rc.1",
    "effect": "^3.16.0"
  },
  "peerDependenciesMeta": {
    "@ts-rest/core": {
      "optional": true
    },
    "effect": {
      "optional": true
    }
  },
  "dependencies": {
    "@mdht/generator-core": "workspace:^0.2.0",
    "@zenstackhq/language": "^3.9.3",
    "@zenstackhq/sdk": "^3.9.3"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
